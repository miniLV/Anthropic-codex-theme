  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FE8019",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#D3869B"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#EBDBB2"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter.object-binding-pattern"
      ],
      "settings": {
        "foreground": "#D3869B"
      }
    },
    {
      "name": "Property and attribute",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D5C4A1"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#B8BB26"
      }
    },
    {
      "name": "String escape and placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated",
        "string.regexp.character-class"
      ],
      "settings": {
        "foreground": "#FABD2F"
      }
    },
    {
      "name": "Number and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FABD2F"
      }
    },
    {
      "name": "Enum members and atoms",
      "scope": [
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#D3869B"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#458588"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#D3869B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#83A598"
      }
    },
    {
      "name": "Tags and selectors",
      "scope": [
        "entity.name.tag",
        "source.css entity.name.tag",
        "meta.selector.css",
        "meta.selector.scss"
      ],
      "settings": {
        "foreground": "#FE8019"
      }
    },
    {
      "name": "Attribute values",
      "scope": [
        "string.quoted.attribute-value",
        "meta.attribute-with-value"
      ],
      "settings": {
        "foreground": "#B8BB26"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#D3869B"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json string.quoted.double"
      ],
      "settings": {
        "foreground": "#D3869B"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#FE8019",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold",
        "markup.italic",
        "markup.quote",
        "markup.list"
      ],
      "settings": {
        "foreground": "#D3869B"
      }
    },
    {
      "name": "Link",
      "scope": [
        "string.other.link",
        "markup.underline.link",
        "markup.link",
        "markup.url"
      ],
      "settings": {
        "foreground": "#458588",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted diff",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#B8BB26"
      }
    },
    {
      "name": "Deleted diff",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#FB4934"
      }
    },
    {
      "name": "Changed diff",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#FABD2F"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FB4934"
      }
    }
  ]
}
