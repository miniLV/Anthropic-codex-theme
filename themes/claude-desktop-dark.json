  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#827E76",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#CA7554",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C49A84"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#E8E4DC"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter.object-binding-pattern"
      ],
      "settings": {
        "foreground": "#C49A84"
      }
    },
    {
      "name": "Property and attribute",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A8A49C"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#8A9E6E"
      }
    },
    {
      "name": "String escape and placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated",
        "string.regexp.character-class"
      ],
      "settings": {
        "foreground": "#D89D73"
      }
    },
    {
      "name": "Number and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#D89D73"
      }
    },
    {
      "name": "Enum members and atoms",
      "scope": [
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#B07A94"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6B8FAE"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#C49A84",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#7A9AB5"
      }
    },
    {
      "name": "Tags and selectors",
      "scope": [
        "entity.name.tag",
        "source.css entity.name.tag",
        "meta.selector.css",
        "meta.selector.scss"
      ],
      "settings": {
        "foreground": "#CA7554"
      }
    },
    {
      "name": "Attribute values",
      "scope": [
        "string.quoted.attribute-value",
        "meta.attribute-with-value"
      ],
      "settings": {
        "foreground": "#8A9E6E"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#B07A94"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json string.quoted.double"
      ],
      "settings": {
        "foreground": "#C49A84"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#CA7554",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold",
        "markup.italic",
        "markup.quote",
        "markup.list"
      ],
      "settings": {
        "foreground": "#C49A84"
      }
    },
    {
      "name": "Link",
      "scope": [
        "string.other.link",
        "markup.underline.link",
        "markup.link",
        "markup.url"
      ],
      "settings": {
        "foreground": "#6B8FAE",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted diff",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#7FA84A"
      }
    },
    {
      "name": "Deleted diff",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#C37967"
      }
    },
    {
      "name": "Changed diff",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#D89D73"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C37967"
      }
    }
  ]
}
